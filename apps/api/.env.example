# Copy to .env (never commit .env)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Supabase Postgres connection string (only needed for DB work; /health runs without it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fakkarni
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fakkarni_test
ANTHROPIC_API_KEY=
# Supabase Auth (M5). URL verifies sign-in tokens; service role key lets account deletion remove the auth user.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# 0 = require sign-in (production), 1 = also accept the phone's install ID
ALLOW_INSTALL_ID=1
# Plans. 1 = enforce the free daily AI allowance (30 a day in week one, then 5); 0 = unlimited for everyone (local development).
REQUIRE_SUBSCRIPTION=0
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
# Hardening (M7)
ADMIN_PASSWORD=
SENTRY_DSN=
# Public /legal/terms and /legal/privacy pages. LEGAL_REVIEWED=1 removes the draft notice.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_REVIEWED=0
NODE_ENV=development
# Invite links (circles). PUBLIC_URL is this API's public address; without it links use the request's host.
PUBLIC_URL=
# Google Play link offered on the invite web page after the confirm tap (empty = "coming soon").
ANDROID_STORE_URL=

# Session (a space to reflect). "1" turns it on; keep it off until `npm run eval` has scored it with a real key.
SESSION_ENABLED=
