// Zaki data model — PRD §6.
// All DateTime columns are UTC; convert with User.timezone at the edges.
// Columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  ar_EG @map("ar-EG")
  en
}

enum Tone {
  playful
  balanced
  calm
}

enum CheckinInterval {
  h2  @map("2")
  h4  @map("4")
  off
}

enum Plan {
  none
  trial
  monthly
  yearly
  expired
}

// Zaki plans (2026-11-22): Pro for one person, Family = Pro for up to 6 people, one payer.
enum PlanTier {
  pro
  family
}

// Circles (Zaki M3): the Friends and Family spaces. Personal has no circle.
enum CircleKind {
  friends
  family
}

enum CircleRole {
  owner
  member
}

// Shared Daftar: pending until the other person answers the link.
enum DaftarStatus {
  pending
  confirmed
  disputed
  settled
  cancelled
}

// Assigned tasks: pending until the person asked says yes (accept first).
enum TaskStatus {
  pending
  accepted
  declined
  done
  cancelled
}

enum Platform {
  ios
  android
}

enum MessageRole {
  user
  friend
}

enum MessageKind {
  chat
  morning
  night
  reminder
  checkin
  followup
  upsell
  update // Zaki telling the user something happened with their people (a debt confirmed…)
}

enum ItemType {
  task
  reminder
  note
  list_item
  debt
}

enum ItemStatus {
  open
  done
  cancelled
}

enum DebtDirection {
  owed_to_me
  i_owe
}

enum MemoryKind {
  person
  place
  preference
  fact
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  authId           String          @unique @map("auth_id") // Supabase Auth user id
  name             String?
  language         Language        @default(ar_EG)
  timezone         String          @default("Africa/Cairo") // IANA
  wakeTime         String          @default("07:00") @map("wake_time") // HH:MM local
  sleepTime        String          @default("23:00") @map("sleep_time") // HH:MM local
  tone             Tone            @default(balanced)
  checkinIntervalH CheckinInterval @default(h2) @map("checkin_interval_h")
  ignoredCheckins  Int             @default(0) @map("ignored_checkins")
  plan             Plan            @default(none)
  planExpiresAt    DateTime?       @map("plan_expires_at")
  planTier         PlanTier        @default(pro) @map("plan_tier")
  // Store product id of the current plan (founders' offer is detected from it).
  planProductId    String?         @map("plan_product_id")
  // Pro days earned by inviting friends (7 per friend, at most 28 a calendar month).
  bonusProUntil    DateTime?       @map("bonus_pro_until")
  referralCode     String?         @unique @map("referral_code")
  referredById     String?         @map("referred_by_id") @db.Uuid
  referralRewardedAt DateTime?     @map("referral_rewarded_at")
  // The user's own InstaPay payment link (https://ipn.eg/…), shown to people who owe them.
  instapayLink     String?         @map("instapay_link")
  // F5: skip the indirect hint and always send the clear reminder.
  alwaysDirect     Boolean         @default(false) @map("always_direct")
  // Proactive-message bookkeeping (M4).
  lastMorningAt    DateTime?       @map("last_morning_at")
  lastNightAt      DateTime?       @map("last_night_at")
  lastCheckinAt    DateTime?       @map("last_checkin_at")
  lastUserMessageAt DateTime?      @map("last_user_message_at")
  slowdownNoticed  Boolean         @default(false) @map("slowdown_noticed")
  createdAt        DateTime        @default(now()) @map("created_at")
  lastActiveAt     DateTime?       @map("last_active_at")

  devices   Device[]
  messages  Message[]
  items     Item[]
  memories  Memory[]
  summaries Summary[]
  events    Event[]
  circles   CircleMember[]
  invitesSent Invite[] @relation("InviteInviter")
  daftarCreated DaftarEntry[] @relation("DaftarCreator")
  daftarOther   DaftarEntry[] @relation("DaftarOther")
  tasksGiven    CircleTask[] @relation("TaskAssigner")
  tasksTaken    CircleTask[] @relation("TaskAssignee")
  trackers      Tracker[]
  sessionConsent SessionConsent?
  reflectSessions ReflectSession[]

  @@index([referredById])
  @@map("users")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  platform   Platform
  pushToken  String?   @unique @map("push_token")
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      MessageRole
  text      String
  clientId  String      @map("client_id") // generated on the phone; makes sync idempotent
  kind      MessageKind @default(chat)
  createdAt DateTime    @default(now()) @map("created_at")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceItems Item[]

  @@unique([userId, clientId])
  @@index([userId, createdAt])
  @@map("messages")
}

model Item {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  type            ItemType
  title           String
  dueAt           DateTime?      @map("due_at")
  // Not in the PRD §6 table, but needed by the response schema (remind_at_local)
  // and by F5 escalation (important items get the clear version at due time).
  remindAt        DateTime?      @map("remind_at")
  important       Boolean        @default(false)
  // F5: the friend's indirect question shown in the local reminder notification.
  nudge           String?
  status          ItemStatus     @default(open)
  debtPerson      String?        @map("debt_person")
  debtAmount      Decimal?       @map("debt_amount") @db.Decimal(12, 2)
  debtDirection   DebtDirection? @map("debt_direction")
  followUpAt      DateTime?      @map("follow_up_at")
  followedUpAt    DateTime?      @map("followed_up_at")
  // Repeating reminder: minutes between occurrences; remindAt moves forward each time.
  repeatEveryMinutes Int?        @map("repeat_every_minutes")
  sourceMessageId String?        @map("source_message_id") @db.Uuid
  updatedAt       DateTime       @updatedAt @map("updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  doneAt          DateTime?      @map("done_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
  @@map("items")
}

/// Long-term memory the user can view and delete (FR-4).
model Memory {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  kind       MemoryKind
  subject    String
  content    String
  lastUsedAt DateTime?  @map("last_used_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@map("memories")
}

/// Rolling chat summary so context stays small (pipeline step 5).
model Summary {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  text        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodEnd])
  @@map("summaries")
}

/// Product analytics. Never put message content in props.
model Event {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  propsJson Json     @default("{}") @map("props_json")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
  @@map("events")
}

/// A group in the Friends or Family space. Free and unlimited (never cap the shared action).
model Circle {
  id          String     @id @default(uuid()) @db.Uuid
  kind        CircleKind
  name        String
  createdById String     @map("created_by_id") @db.Uuid
  // Family circles: parents_teens | adults_elders | spouses | mixed (see shared FamilyType).
  familyType  String?    @map("family_type")
  createdAt   DateTime   @default(now()) @map("created_at")

  members CircleMember[]
  invites Invite[]
  daftar  DaftarEntry[]
  tasks   CircleTask[]
  posts   CirclePost[]

  @@map("circles")
}

model CircleMember {
  circleId String     @map("circle_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     CircleRole @default(member)
  // The member's own place in a family circle (shared FamilyRole). Optional.
  familyRole String?  @map("family_role")
  joinedAt DateTime   @default(now()) @map("joined_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@index([userId])
  @@map("circle_members")
}

/// An invite link sent over WhatsApp. One link can bring in several people (it may be
/// posted in a family group). The code is in the URL and can also be typed in the app.
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  circleId    String    @map("circle_id") @db.Uuid
  inviterId   String    @map("inviter_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  // Funnel counters: taps on "confirm" on the web page, and people who joined in the app.
  webConfirms Int       @default(0) @map("web_confirms")
  joins       Int       @default(0)

  circle  Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviter User   @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@index([inviterId])
  @@map("invites")
}

/// Shared Daftar: a debt between two people, recorded only. Zaki never holds or moves money.
/// The creator sends a link; the other person confirms on the web with nothing to install.
model DaftarEntry {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  creatorId   String        @map("creator_id") @db.Uuid
  // Optional: the circle this belongs to. Only the two people involved ever see the entry.
  circleId    String?       @map("circle_id") @db.Uuid
  // The other person: a name the creator typed, linked to an account once they open it in the app.
  otherName   String        @map("other_name")
  otherUserId String?       @map("other_user_id") @db.Uuid
  // From the creator's side: owed_to_me = the other person owes the creator.
  direction   DebtDirection
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("EGP")
  note        String?
  status      DaftarStatus  @default(pending)
  respondedAt DateTime?     @map("responded_at")
  respondedVia String?      @map("responded_via") // "web" | "app"
  settledAt   DateTime?     @map("settled_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  creator User    @relation("DaftarCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  other   User?   @relation("DaftarOther", fields: [otherUserId], references: [id], onDelete: SetNull)
  circle  Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([otherUserId, status])
  @@map("daftar_entries")
}

/// A task one circle member asks another to do. Nothing lands in the other person's list
/// until they accept; then it becomes one of their own items (linked by itemId).
model CircleTask {
  id          String     @id @default(uuid()) @db.Uuid
  circleId    String     @map("circle_id") @db.Uuid
  assignerId  String     @map("assigner_id") @db.Uuid
  assigneeId  String     @map("assignee_id") @db.Uuid
  title       String
  dueAt       DateTime?  @map("due_at")
  status      TaskStatus @default(pending)
  // The assignee's own item, created when they accept. Marking it done finishes the task.
  itemId      String?    @unique @map("item_id") @db.Uuid
  respondedAt DateTime?  @map("responded_at")
  doneAt      DateTime?  @map("done_at")
  // Nudges the assigner asked Zaki to send (rate-limited; see tasks/rules.ts).
  nudges      Int        @default(0)
  lastNudgeAt DateTime?  @map("last_nudge_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  assigner User   @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Cascade)
  assignee User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
  @@index([assigneeId, status])
  @@index([assignerId, status])
  @@map("circle_tasks")
}

/// What Zaki posts in a circle (always labelled as Zaki). Stored as an event plus the names
/// it needs, and written out in each reader's language. Never free text from a model.
model CirclePost {
  id        String   @id @default(uuid()) @db.Uuid
  circleId  String   @map("circle_id") @db.Uuid
  event     String
  actorId   String?  @map("actor_id") @db.Uuid
  targetId  String?  @map("target_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@map("circle_posts")
}

/// One thing the user follows (water, prayer, spending…). Kinds and their defaults live in
/// packages/shared/src/trackers.ts. Free users keep one; Pro has no limit.
model Tracker {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String
  name      String?
  goal      Decimal? @db.Decimal(12, 2)
  // "ramadan" for trackers added by the Ramadan pack: free, outside the 1-tracker limit.
  pack      String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TrackerEntry[]

  @@index([userId])
  @@map("trackers")
}

model TrackerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  trackerId String   @map("tracker_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  // "tap" (the dashboard) or "chat" (a message Zaki read by rules).
  source    String
  at        DateTime @default(now())

  tracker Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@index([trackerId, at])
  @@map("tracker_entries")
}

/// Session (a space to reflect, never called therapy). Sensitive data: its own explicit
/// consent, its own tables, never read by the chat, memories, summaries or analytics.
model SessionConsent {
  userId      String   @id @map("user_id") @db.Uuid
  version     String
  // The user confirmed they are 18 or older.
  adult       Boolean
  consentedAt DateTime @map("consented_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_consents")
}

model ReflectSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  mode      String
  mood      Int
  crisis    Boolean   @default(false)
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ReflectMessage[]

  @@index([userId, startedAt])
  @@map("reflect_sessions")
}

model ReflectMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // "user" | "zaki"
  text      String
  // One small step Zaki suggested with this message, if any.
  stepTitle    String?   @map("step_title")
  stepAt       DateTime? @map("step_at")
  stepAccepted Boolean   @default(false) @map("step_accepted")
  createdAt DateTime @map("created_at")

  session ReflectSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("reflect_messages")
}
