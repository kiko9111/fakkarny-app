# Copy to .env.local (Expo loads it). Both Supabase values are public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave empty in development: the app finds the API on the machine running Metro.
EXPO_PUBLIC_API_URL=
# RevenueCat public SDK keys (M6). Without them the paywall says subscriptions aren't available.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Sentry crash reporting (M7)
EXPO_PUBLIC_SENTRY_DSN=
