<?xml version="1.0" encoding="utf-8"?>
<!-- Generated twice (ltr / rtl) so the widget follows the app's language, not the phone's. Keep both in step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/zw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layoutDirection="rtl"
  android:background="@drawable/zaki_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:id="@+id/zw_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@null"
      android:src="@drawable/zaki_widget_mark" />
    <TextView
      android:id="@+id/zw_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:gravity="start"
      android:text="@string/zaki_widget_label"
      android:textColor="#2B211C"
      android:textSize="16sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/zw_needs"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/zaki_widget_pill"
      android:paddingStart="10dp"
      android:paddingTop="3dp"
      android:paddingEnd="10dp"
      android:paddingBottom="3dp"
      android:maxLines="1"
      android:textColor="#C54315"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/zw_need"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/zaki_widget_pill"
    android:ellipsize="end"
    android:maxLines="1"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp"
    android:textAlignment="viewStart"
    android:gravity="start"
    android:textColor="#2B211C"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/zw_rows"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/zw_dose"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">
      <TextView
        android:id="@+id/zw_dose_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:textColor="#C54315"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/zw_dose_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:gravity="start"
        android:textColor="#2B211C"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/zw_dose_done"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/zaki_widget_check"
        android:gravity="center"
        android:text="✓"
        android:textColor="#C54315"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/zw_p0"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">
      <TextView
        android:id="@+id/zw_p0_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:textColor="#C54315"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/zw_p0_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:gravity="start"
        android:textColor="#2B211C"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/zw_p0_done"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/zaki_widget_check"
        android:gravity="center"
        android:text="✓"
        android:textColor="#C54315"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/zw_p1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">
      <TextView
        android:id="@+id/zw_p1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:textColor="#C54315"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/zw_p1_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:gravity="start"
        android:textColor="#2B211C"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/zw_p1_done"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/zaki_widget_check"
        android:gravity="center"
        android:text="✓"
        android:textColor="#C54315"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/zw_p2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">
      <TextView
        android:id="@+id/zw_p2_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:textColor="#C54315"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/zw_p2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:gravity="start"
        android:textColor="#2B211C"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/zw_p2_done"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/zaki_widget_check"
        android:gravity="center"
        android:text="✓"
        android:textColor="#C54315"
        android:textSize="15sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/zw_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textAlignment="viewStart"
      android:gravity="start"
      android:text="@string/zaki_widget_empty"
      android:textColor="#7A6A61"
      android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/zw_talk"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:background="@drawable/zaki_widget_button"
      android:gravity="center"
      android:maxLines="1"
      android:text="@string/zaki_widget_talk"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/zw_remind"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/zaki_widget_pill"
      android:gravity="center"
      android:maxLines="1"
      android:text="@string/zaki_widget_remind"
      android:textColor="#C54315"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
