{
  "expo": {
    "name": "Zaki",
    "slug": "fakkarni",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.fakkarni.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en",
          "ar",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fakkarni.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-web-browser",
      "expo-sharing",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "scheme": "fakkarni",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "249766b3-d4c3-46d0-b596-3004a690def9"
      }
    },
    "owner": "kiki91111",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/249766b3-d4c3-46d0-b596-3004a690def9"
    }
  }
}
