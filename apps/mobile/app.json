{
  "expo": {
    "name": "Zaki",
    "slug": "fakkarni",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.fakkarni.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en",
          "ar",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF9A76",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fakkarni.app",
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-web-browser",
      "expo-sharing",
      "expo-apple-authentication",
      "@sentry/react-native",
      [
        "expo-contacts",
        {
          "contactsPermission": "Zaki only reads the one contact you pick, to fill in their name."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaki uses the photo you pick to read a receipt or hand in homework.",
          "cameraPermission": "Zaki uses the camera only when you snap a receipt or homework page.",
          "microphonePermission": "Zaki uses the microphone only for voice typing. Your voice stays on your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F2"
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zaki checks whether you are at a place you saved, to remind you of things there. Your location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": "Zaki reminds you of things when you arrive at a place you saved, even when the app is closed. Your location stays on your phone and is never sent.",
          "locationAlwaysPermission": "Zaki reminds you of things when you arrive at a place you saved, even when the app is closed. Your location stays on your phone and is never sent.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "scheme": "fakkarni",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "249766b3-d4c3-46d0-b596-3004a690def9"
      }
    },
    "owner": "kiki91111",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/249766b3-d4c3-46d0-b596-3004a690def9"
    }
  }
}
